graph DER {
graph [layout=dot, rankdir=LR, nodesep=0.35, ranksep=0.55, splines=true, pad=0.35, fontname="Helvetica", label="Figura 3 — Análises (dos analistas e automáticas da IA)\nNotação de Chen — (mín,máx) escrito no traço de cada entidade", labelloc=t, fontsize=22];
node [fontname="Helvetica"]; edge [fontname="Helvetica-Bold", fontsize=13, fontcolor="#B45309", color="#475569", penwidth=1.4];
"ANALISE_PUBLICADA" [shape=box, style="filled,bold", fillcolor="#FCE7F3", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ANALISE_PUBLICADA</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_analise_pub</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">título</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">resumo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">texto</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">período</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nível de confiança</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">versão</FONT></TD></TR></TABLE>>];
"ANALISE_EVIDENCIA" [shape=box, style="filled,bold", fillcolor="#FCE7F3", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ANALISE_EVIDENCIA</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_evidencia</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">consulta SQL / link</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descrição</FONT></TD></TR></TABLE>>];
"ANALISE_COMENTARIO" [shape=box, style="filled,bold", fillcolor="#FCE7F3", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ANALISE_COMENTARIO</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_comentario</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">texto</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">data</FONT></TD></TR></TABLE>>];
"ANALISE_IA" [shape=box, style="filled,bold", fillcolor="#DCFCE7", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ANALISE_IA</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_analise</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">título</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descrição</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">confiança</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">severidade</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR></TABLE>>];
"USUARIO" [shape=box, style="dashed,filled", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#64748B", fontsize=13, width=2.2, height=0.55, label=<<B>USUARIO</B>>];
"INDICADOR" [shape=box, style="dashed,filled", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#64748B", fontsize=13, width=2.2, height=0.55, label=<<B>INDICADOR</B>>];
"MUNICIPIO" [shape=box, style="dashed,filled", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#64748B", fontsize=13, width=2.2, height=0.55, label=<<B>MUNICIPIO</B>>];
"SERVICO_PUBLICO" [shape=box, style="dashed,filled", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#64748B", fontsize=13, width=2.2, height=0.55, label=<<B>SERVICO_PUBLICO</B>>];
"R20" [shape=diamond, label="é analisado", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"INDICADOR" -- "R20" [label="(1,1)"];
"R20" -- "ANALISE_IA" [label="(0,N)"];
"R21" [shape=diamond, label="é analisado", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
