"R37" [shape=diamond, label="classifica", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"SERVICO_PUBLICO" -- "R37" [label="(1,1)"];
"R37" -- "ANALISE_PUBLICADA" [label="(0,N)"];
"R38" [shape=diamond, label="escreve", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R38" [label="(1,1)"];
"R38" -- "ANALISE_PUBLICADA" [label="(0,N)"];
"R39" [shape=diamond, label="revisa", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R39" [label="(0,1)"];
"R39" -- "ANALISE_PUBLICADA" [label="(0,N)"];
"R40" [shape=diamond, label="trata de", style=filled, fillcolor="#FDE68A", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"ANALISE_PUBLICADA" -- "R40" [label="(0,N)"];
"R40" -- "MUNICIPIO" [label="(0,N)"];
"R41" [shape=diamond, label="comprova", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"ANALISE_PUBLICADA" -- "R41" [label="(1,1)"];
"R41" -- "ANALISE_EVIDENCIA" [label="(0,N)"];
"R42" [shape=diamond, label="é citado", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"INDICADOR" -- "R42" [label="(0,1)"];
