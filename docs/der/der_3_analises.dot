"R43" [shape=diamond, label="recebe", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"ANALISE_PUBLICADA" -- "R43" [label="(1,1)"];
"R43" -- "ANALISE_COMENTARIO" [label="(0,N)"];
"R44" [shape=diamond, label="comenta", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R44" [label="(1,1)"];
"R44" -- "ANALISE_COMENTARIO" [label="(0,N)"];
}