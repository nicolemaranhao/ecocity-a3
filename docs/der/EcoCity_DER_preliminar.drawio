mxGeometry x="0.75" relative="1" as="geometry"><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="c126" value="comprova" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1092" y="1024" width="96" height="50" as="geometry"/></mxCell><mxCell id="c127" style="endArrow=none;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.3;exitX=0.9;exitY=1.0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c126"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="1049"/></Array></mxGeometry></mxCell><mxCell id="c128" value="(1,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=11;fontColor=#B45309;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c127"><mxGeometry x="-0.55" relative="1" as="geometry"><mxPoint x="20" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c129" style="endArrow=none;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c126" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="1049"/></Array></mxGeometry></mxCell><mxCell id="c130" value="(0,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=11;fontColor=#B45309;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c129"><mxGeometry x="0.55" relative="1" as="geometry"><mxPoint x="20" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c131" value="&lt;b style=&quot;font-size:22px&quot;&gt;EcoCity — DER preliminar (modelo conceitual)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;A3 Banco de Dados · Checkpoint 2 · notação de Chen com cardinalidade (mín,máx)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="60" as="geometry"/></mxCell><mxCell id="c132" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;▭ &lt;b&gt;Retângulo&lt;/b&gt; = entidade (vira tabela)&lt;br&gt;◇ &lt;b&gt;Losango&lt;/b&gt; = relacionamento (verbo)&lt;br&gt;&lt;u&gt;sublinhado&lt;/u&gt; = identificador (chave)&lt;br&gt;&lt;b style=&quot;color:#B45309&quot;&gt;(mín,máx)&lt;/b&gt; junto da entidade = quantas&lt;br&gt;vezes ELA aparece para UMA do outro lado&lt;br&gt;&lt;span style=&quot;background:#FDE68A&quot;&gt;&amp;nbsp;losango amarelo&amp;nbsp;&lt;/span&gt; = N:N (vira tabela associativa)&lt;br&gt;&lt;br&gt;&lt;b&gt;Exemplo:&lt;/b&gt; ORGAO (1,1) — publica — (0,N) FONTE_DADOS&lt;br&gt;Cada fonte é publicada por 1 órgão;&lt;br&gt;cada órgão publica de 0 a N fontes." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#FFFFFF;strokeColor=#94A3B8;spacing=10;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="260" height="250" as="geometry"/></mxCell><mxCell id="c133" value="&lt;b&gt;Fica para o modelo lógico (Checkpoint 3)&lt;/b&gt;&lt;br&gt;Tabelas de apoio: UNIDADE_MEDIDA, LOTE_CARGA, STG_MEDICAO_BRUTA, ACESSO_LOG, AUDITORIA, ANALISE_EVIDENCIA, ANALISE_COMENTARIO, PERGUNTA_IA e o Data Warehouse (dim_* e fato_*).&lt;br&gt;Também no CP3: chaves estrangeiras, tipos de dado e os vínculos extras (quem dá parecer e aprova a meta, quem revisa análises, quem avalia a fonte, qual admin aprovou o cadastro)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;spacing=10;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="260" height="250" as="geometry"/></mxCell><mxCell id="c134" value="" style="rounded=0;fillColor=#E0E7FF;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1560.0" y="1120" width="22" height="18" as="geometry"/></mxCell><mxCell id="c135" value="Cidades, fontes e dados mensais" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1590.0" y="1117" width="300" height="24" as="geometry"/></mxCell><mxCell id="c136" value="" style="rounded=0;fillColor=#DCFCE7;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1560.0" y="1150" width="22" height="18" as="geometry"/></mxCell><mxCell id="c137" value="Indicadores, metas e alertas" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1590.0" y="1147" width="300" height="24" as="geometry"/></mxCell><mxCell id="c138" value="" style="rounded=0;fillColor=#FCE7F3;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1560.0" y="1180" width="22" height="18" as="geometry"/></mxCell><mxCell id="c139" value="Análises e relatórios" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1590.0" y="1177" width="300" height="24" as="geometry"/></mxCell><mxCell id="c140" value="" style="rounded=0;fillColor=#FEF3C7;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1560.0" y="1210" width="22" height="18" as="geometry"/></mxCell><mxCell id="c141" value="Ações e resultados" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1590.0" y="1207" width="300" height="24" as="geometry"/></mxCell><mxCell id="c142" value="" style="rounded=0;fillColor=#F1F5F9;strokeColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1560.0" y="1240" width="22" height="18" as="geometry"/></mxCell><mxCell id="c143" value="Pessoas e acesso" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1590.0" y="1237" width="300" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>