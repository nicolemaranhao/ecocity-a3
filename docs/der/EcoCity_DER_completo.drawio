keWidth=1.3;exitX=0.875;exitY=0.0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c204"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1760" y="1170"/></Array></mxGeometry></mxCell><mxCell id="c206" value="(1,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=11;fontColor=#B45309;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c205"><mxGeometry x="-0.6" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c207" style="endArrow=none;html=1;rounded=0;strokeColor=#334155;strokeWidth=1.3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c204" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2840" y="1170"/></Array></mxGeometry></mxCell><mxCell id="c208" value="(0,N)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;fontSize=11;fontColor=#B45309;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="c207"><mxGeometry x="0.6" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c209" value="&lt;b style=&quot;font-size:24px&quot;&gt;EcoCity — DER (modelo conceitual)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;A3 Banco de Dados · Checkpoint 2 · notação de Chen com cardinalidade (mín,máx)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="-40" y="-130" width="1600" height="70" as="geometry"/></mxCell><mxCell id="c210" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;Retângulo = entidade (vira tabela), com seus atributos · &lt;u&gt;sublinhado&lt;/u&gt; = identificador · Losango = relacionamento&lt;br&gt;&lt;b style=&quot;color:#B45309&quot;&gt;(mín,máx)&lt;/b&gt; junto da entidade = quantas vezes ELA aparece para UMA do outro lado&lt;br&gt;&lt;span style=&quot;background:#FDE68A&quot;&gt;&amp;nbsp;Losango amarelo&amp;nbsp;&lt;/span&gt; = relacionamento N:N (vira tabela associativa)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fillColor=#FFFFFF;strokeColor=#94A3B8;spacing=12;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2080" y="1360" width="900" height="150" as="geometry"/></mxCell><mxCell id="c211" value="&lt;b&gt;Fora do DER conceitual (entram no modelo lógico do CP3):&lt;/b&gt;&lt;br&gt;tabelas técnicas LOTE_CARGA, STG_MEDICAO_BRUTA, UNIDADE_MEDIDA, ACESSO_LOG, AUDITORIA e o Data Warehouse (dim_* e fato_*), além de vínculos secundários (quem revisa, aprova ou avalia)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;spacing=12;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="2080" y="1530" width="900" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>