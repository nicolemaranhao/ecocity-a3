"R3" [shape=diamond, label="recebe", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"LOTE_CARGA" -- "R3" [label="(1,1)"];
"R3" -- "STG_MEDICAO_BRUTA" [label="(0,N)"];
"R4" [shape=diamond, label="é conferida em", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
