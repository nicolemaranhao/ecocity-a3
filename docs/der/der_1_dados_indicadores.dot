"SERVICO_PUBLICO" -- "R6" [label="(1,1)"];
"R6" -- "METRICA" [label="(0,N)"];
"R7" [shape=diamond, label="expressa", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"UNIDADE_MEDIDA" -- "R7" [label="(1,1)"];
"R7" -- "METRICA" [label="(0,N)"];
"R8" [shape=diamond, label="fornece", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"FONTE_DADOS" -- "R8" [label="(1,1)"];
"R8" -- "DADO" [label="(0,N)"];
"R9" [shape=diamond, label="carrega", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"LOTE_CARGA" -- "R9" [label="(0,1)"];
"R9" -- "DADO" [label="(0,N)"];
"R10" [shape=diamond, label="é medida em", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"METRICA" -- "R10" [label="(1,1)"];
"R10" -- "DADO" [label="(0,N)"];
"R11" [shape=diamond, label="tem", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"MUNICIPIO" -- "R11" [label="(1,1)"];
"R11" -- "DADO" [label="(0,N)"];
