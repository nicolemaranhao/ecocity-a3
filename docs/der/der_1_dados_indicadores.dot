graph DER {
graph [layout=dot, rankdir=LR, nodesep=0.35, ranksep=0.55, splines=true, pad=0.35, fontname="Helvetica", label="Figura 1 — Dados, indicadores e metas\nNotação de Chen — (mín,máx) escrito no traço de cada entidade", labelloc=t, fontsize=22];
node [fontname="Helvetica"]; edge [fontname="Helvetica-Bold", fontsize=13, fontcolor="#B45309", color="#475569", penwidth=1.4];
"ORGAO" [shape=box, style="filled,bold", fillcolor="#FCE7F3", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ORGAO</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_orgao</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sigla</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tipo</FONT></TD></TR></TABLE>>];
"FONTE_DADOS" [shape=box, style="filled,bold", fillcolor="#FCE7F3", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>FONTE_DADOS</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_fonte</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">formato</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">frequência</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">link</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">confiabilidade</FONT></TD></TR></TABLE>>];
"LOTE_CARGA" [shape=box, style="filled,bold", fillcolor="#FCE7F3", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>LOTE_CARGA</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_lote</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">início / fim</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">lidos / válidos / rejeitados</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR></TABLE>>];
"STG_MEDICAO_BRUTA" [shape=box, style="filled,bold", fillcolor="#FCE7F3", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>STG_MEDICAO_BRUTA</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_stg</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">métrica, cidade, data e valor (texto)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">origem e referência informadas</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">erro</FONT></TD></TR></TABLE>>];
"COLETA_VERIFICACAO" [shape=box, style="filled,bold", fillcolor="#FCE7F3", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>COLETA_VERIFICACAO</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_verificacao</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">quando conferiu</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">versão publicada</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">situação</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">mensagem</FONT></TD></TR></TABLE>>];
"SERVICO_PUBLICO" [shape=box, style="filled,bold", fillcolor="#E0E7FF", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>SERVICO_PUBLICO</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_servico</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descrição</FONT></TD></TR></TABLE>>];
"UNIDADE_MEDIDA" [shape=box, style="filled,bold", fillcolor="#E0E7FF", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>UNIDADE_MEDIDA</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_unidade</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sigla</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descrição</FONT></TD></TR></TABLE>>];
"METRICA" [shape=box, style="filled,bold", fillcolor="#E0E7FF", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>METRICA</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_metrica</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">código</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome</FONT></TD></TR></TABLE>>];
"DADO" [shape=box, style="filled,bold", fillcolor="#E0E7FF", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>DADO</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_dado</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">mês de referência</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">valor</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">qualidade</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">origem</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">referência da origem</FONT></TD></TR></TABLE>>];
"MUNICIPIO" [shape=box, style="filled,bold", fillcolor="#E0E7FF", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>MUNICIPIO</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_municipio</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">código IBGE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">região metropolitana</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">área</FONT></TD></TR></TABLE>>];
"POPULACAO_ANUAL" [shape=box, style="filled,bold", fillcolor="#E0E7FF", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>POPULACAO_ANUAL</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>ano</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">população</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fonte</FONT></TD></TR></TABLE>>];
"INDICADOR" [shape=box, style="filled,bold", fillcolor="#DCFCE7", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>INDICADOR</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_indicador</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">código</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fórmula</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sentido</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ODS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">peso</FONT></TD></TR></TABLE>>];
"INDICADOR_VALOR" [shape=box, style="filled,bold", fillcolor="#DCFCE7", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>INDICADOR_VALOR</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_indicador_valor</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">mês</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">valor</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">origem</FONT></TD></TR></TABLE>>];
"META" [shape=box, style="filled,bold", fillcolor="#DCFCE7", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>META</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_meta</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">meta escrita (descrição)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">valor e ponto de partida</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">vigência e prazo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">como atingir (projetos)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">justificativa e referência</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status e parecer</FONT></TD></TR></TABLE>>];
"R0" [shape=diamond, label="publica", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"ORGAO" -- "R0" [label="(1,1)"];
"R0" -- "FONTE_DADOS" [label="(0,N)"];
"R1" [shape=diamond, label="abrange", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"SERVICO_PUBLICO" -- "R1" [label="(1,1)"];
"R1" -- "FONTE_DADOS" [label="(0,N)"];
