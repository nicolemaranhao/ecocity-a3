"MUNICIPIO" -- "R12" [label="(1,1)"];
"R12" -- "POPULACAO_ANUAL" [label="(0,N)"];
"R13" [shape=diamond, label="agrupa", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"SERVICO_PUBLICO" -- "R13" [label="(1,1)"];
"R13" -- "INDICADOR" [label="(0,N)"];
