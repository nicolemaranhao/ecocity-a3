graph DER {
graph [layout=dot, rankdir=LR, nodesep=0.35, ranksep=0.55, splines=true, pad=0.35, fontname="Helvetica", label="Figura 2 — Pessoas, segurança e responsáveis pelas metas\nNotação de Chen — (mín,máx) escrito no traço de cada entidade", labelloc=t, fontsize=22];
node [fontname="Helvetica"]; edge [fontname="Helvetica-Bold", fontsize=13, fontcolor="#B45309", color="#475569", penwidth=1.4];
"PERFIL" [shape=box, style="filled,bold", fillcolor="#F1F5F9", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>PERFIL</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_perfil</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">exige 2ª etapa</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">validade da senha</FONT></TD></TR></TABLE>>];
"USUARIO" [shape=box, style="filled,bold", fillcolor="#F1F5F9", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>USUARIO</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_usuario</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">e-mail</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">senha (hash)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ativo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">2ª etapa ativa</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">bloqueado até</FONT></TD></TR></TABLE>>];
"CREDENCIAL_ANALISTA" [shape=box, style="filled,bold", fillcolor="#F1F5F9", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>CREDENCIAL_ANALISTA</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">órgão de vínculo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">registro profissional</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nível</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">válida até</FONT></TD></TR></TABLE>>];
"ACESSO_LOG" [shape=box, style="filled,bold", fillcolor="#F1F5F9", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ACESSO_LOG</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_acesso</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">e-mail tentado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">resultado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">IP</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">data/hora</FONT></TD></TR></TABLE>>];
"AUDITORIA" [shape=box, style="filled,bold", fillcolor="#F1F5F9", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>AUDITORIA</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_auditoria</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tabela</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">operação</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">usuário do banco</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">antes / depois</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">data/hora</FONT></TD></TR></TABLE>>];
"SERVICO_PUBLICO" [shape=box, style="dashed,filled", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#64748B", fontsize=13, width=2.2, height=0.55, label=<<B>SERVICO_PUBLICO</B>>];
"FONTE_DADOS" [shape=box, style="dashed,filled", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#64748B", fontsize=13, width=2.2, height=0.55, label=<<B>FONTE_DADOS</B>>];
"META" [shape=box, style="dashed,filled", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#64748B", fontsize=13, width=2.2, height=0.55, label=<<B>META</B>>];
"MUNICIPIO" [shape=box, style="dashed,filled", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#64748B", fontsize=13, width=2.2, height=0.55, label=<<B>MUNICIPIO</B>>];
"R17" [shape=diamond, label="propõe", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R17" [label="(1,1)"];
"R17" -- "META" [label="(0,N)"];
"R18" [shape=diamond, label="dá parecer", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R18" [label="(0,1)"];
"R18" -- "META" [label="(0,N)"];
"R19" [shape=diamond, label="aprova", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R19" [label="(0,1)"];
"R19" -- "META" [label="(0,N)"];
"R23" [shape=diamond, label="define", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"PERFIL" -- "R23" [label="(1,1)"];
"R23" -- "USUARIO" [label="(0,N)"];
"R24" [shape=diamond, label="é de interesse", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"MUNICIPIO" -- "R24" [label="(0,1)"];
"R24" -- "USUARIO" [label="(0,N)"];
"R25" [shape=diamond, label="possui", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R25" [label="(1,1)"];
"R25" -- "CREDENCIAL_ANALISTA" [label="(0,1)"];
"R26" [shape=diamond, label="habilita", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"SERVICO_PUBLICO" -- "R26" [label="(0,1)"];
"R26" -- "CREDENCIAL_ANALISTA" [label="(0,N)"];
"R27" [shape=diamond, label="verifica", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R27" [label="(0,1)"];
"R27" -- "CREDENCIAL_ANALISTA" [label="(0,N)"];
"R28" [shape=diamond, label="avalia", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R28" [label="(0,1)"];
"R28" -- "FONTE_DADOS" [label="(0,N)"];
"R29" [shape=diamond, label="tenta entrar", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R29" [label="(0,1)"];
"R29" -- "ACESSO_LOG" [label="(0,N)"];
"nota_aud" [shape=note, fontsize=11, color="#94A3B8", fontcolor="#475569", label="AUDITORIA não se liga por FK:\nguarda o histórico de alterações\nde qualquer tabela (via triggers)"];
"AUDITORIA" -- "nota_aud" [style=dotted, color="#94A3B8"];
}