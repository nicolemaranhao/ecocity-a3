graph DER {
graph [layout=dot, rankdir=LR, nodesep=0.35, ranksep=0.55, splines=true, pad=0.35, fontname="Helvetica", label="Figura 4 — Ações, resultados e Copiloto (IA)\nNotação de Chen — (mín,máx) escrito no traço de cada entidade", labelloc=t, fontsize=22];
node [fontname="Helvetica"]; edge [fontname="Helvetica-Bold", fontsize=13, fontcolor="#B45309", color="#475569", penwidth=1.4];
"ACAO" [shape=box, style="filled,bold", fillcolor="#FEF3C7", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ACAO</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_acao</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">título</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descrição</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">início / fim previsto</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">orçamento</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR></TABLE>>];
"RESULTADO" [shape=box, style="filled,bold", fillcolor="#FEF3C7", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>RESULTADO</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_resultado</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">valor antes</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">valor depois</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">data</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">avaliação</FONT></TD></TR></TABLE>>];
"RELATORIO_IA" [shape=box, style="filled,bold", fillcolor="#CCFBF1", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>RELATORIO_IA</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_relatorio</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">título</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">público</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">período</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">texto</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">dados usados</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">% base oficial</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR></TABLE>>];
"PERGUNTA_IA" [shape=box, style="filled,bold", fillcolor="#CCFBF1", color="#1E293B", fontsize=13, margin="0.1,0.05", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>PERGUNTA_IA</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>id_pergunta</U> (id)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">pergunta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">SQL gerado</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">situação</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">motivo do bloqueio</FONT></TD></TR></TABLE>>];
"USUARIO" [shape=box, style="dashed,filled", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#64748B", fontsize=13, width=2.2, height=0.55, label=<<B>USUARIO</B>>];
"INDICADOR" [shape=box, style="dashed,filled", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#64748B", fontsize=13, width=2.2, height=0.55, label=<<B>INDICADOR</B>>];
"MUNICIPIO" [shape=box, style="dashed,filled", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#64748B", fontsize=13, width=2.2, height=0.55, label=<<B>MUNICIPIO</B>>];
"ANALISE_IA" [shape=box, style="dashed,filled", fillcolor="#F8FAFC", color="#94A3B8", fontcolor="#64748B", fontsize=13, width=2.2, height=0.55, label=<<B>ANALISE_IA</B>>];
"R30" [shape=diamond, label="recebe", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"MUNICIPIO" -- "R30" [label="(1,1)"];
"R30" -- "ACAO" [label="(0,N)"];
"R31" [shape=diamond, label="é alvo de", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"INDICADOR" -- "R31" [label="(1,1)"];
"R31" -- "ACAO" [label="(0,N)"];
"R32" [shape=diamond, label="é responsável", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R32" [label="(1,1)"];
"R32" -- "ACAO" [label="(0,N)"];
"R33" [shape=diamond, label="motiva", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"ANALISE_IA" -- "R33" [label="(0,1)"];
"R33" -- "ACAO" [label="(0,N)"];
"R34" [shape=diamond, label="produz", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"ACAO" -- "R34" [label="(1,1)"];
"R34" -- "RESULTADO" [label="(0,N)"];
"R35" [shape=diamond, label="mede", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"INDICADOR" -- "R35" [label="(1,1)"];
"R35" -- "RESULTADO" [label="(0,N)"];
"R36" [shape=diamond, label="registra", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R36" [label="(1,1)"];
"R36" -- "RESULTADO" [label="(0,N)"];
"R45" [shape=diamond, label="solicita", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R45" [label="(1,1)"];
"R45" -- "RELATORIO_IA" [label="(0,N)"];
"R46" [shape=diamond, label="aprova", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R46" [label="(0,1)"];
"R46" -- "RELATORIO_IA" [label="(0,N)"];
"R47" [shape=diamond, label="abrange", style=filled, fillcolor="#FDE68A", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"RELATORIO_IA" -- "R47" [label="(0,N)"];
"R47" -- "MUNICIPIO" [label="(1,N)"];
"R48" [shape=diamond, label="pergunta", style=filled, fillcolor="#FFFFFF", color="#1E293B", fontsize=11, width=1.5, height=0.65, margin=0.02];
"USUARIO" -- "R48" [label="(1,1)"];
"R48" -- "PERGUNTA_IA" [label="(0,N)"];
}