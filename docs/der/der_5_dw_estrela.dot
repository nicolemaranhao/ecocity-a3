digraph G { graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, label="Figura 5 — Data Warehouse em modelo estrela (grão mensal)", pad=0.4, nodesep=0.5, ranksep=0.9, bgcolor="white", splines=spline];
node [shape=plaintext, fontname="Helvetica", fontsize=10]; edge [color="#64748B", dir=none, penwidth=1.2, fontname="Helvetica-Bold", fontsize=13, fontcolor="#B45309", labeldistance=1.6, labelangle=25];
"dim_tempo" [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#334155"><FONT COLOR="white"><B>DIM_TEMPO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT"><B>sk_tempo</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">UK</FONT></TD><TD ALIGN="LEFT">data_inicio</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">DATE NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">ano</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">SMALLINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">semestre</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">TINYINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">trimestre</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">TINYINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">mes</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">TINYINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">nome_mes</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">VARCHAR NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">rotulo</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">CHAR NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">ano_mes</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">CHAR NN</FONT></TD></TR></TABLE>>];
"dim_municipio" [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#334155"><FONT COLOR="white"><B>DIM_MUNICIPIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">PK</FONT></TD><TD ALIGN="LEFT"><B>sk_municipio</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">SMALLINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">UK</FONT></TD><TD ALIGN="LEFT">id_municipio_origem</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">SMALLINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">VARCHAR NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">codigo_ibge</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">CHAR NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">regiao_metropolitana</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">VARCHAR NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">populacao</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">area_km2</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">DECIMAL NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">densidade_hab_km2</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">DECIMAL NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">atualizado_em</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">DATETIME NN</FONT></TD></TR></TABLE>>];
