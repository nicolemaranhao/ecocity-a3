"fato_medicao" [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0F766E"><FONT COLOR="white"><B>FATO_MEDICAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>sk_tempo</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>sk_municipio</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">SMALLINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>sk_metrica</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">SMALLINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">sk_servico</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">TINYINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">valor_total</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">DECIMAL NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">valor_per_capita</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">DECIMAL NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">qtd_registros</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">qtd_suspeitos</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">qtd_derivados</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">qtd_estimados</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT NN</FONT></TD></TR></TABLE>>];
"fato_indicador" [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#0F766E"><FONT COLOR="white"><B>FATO_INDICADOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>sk_tempo</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">INT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>sk_municipio</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">SMALLINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>sk_indicador</B></TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">SMALLINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">FK</FONT></TD><TD ALIGN="LEFT">sk_servico</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">TINYINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">valor</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">DECIMAL NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">meta</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">DECIMAL NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">atingiu_meta</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">TINYINT NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">score</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">DECIMAL NN</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8"> </FONT></TD><TD ALIGN="LEFT">origem</TD><TD ALIGN="LEFT"><FONT COLOR="#6B7280" POINT-SIZE="8">VARCHAR NN</FONT></TD></TR></TABLE>>];
