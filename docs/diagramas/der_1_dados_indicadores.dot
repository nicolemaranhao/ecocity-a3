digraph G { graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, label="Figura 1 — Integração, medições mensais, indicadores e metas", pad=0.4, nodesep=0.5, ranksep=0.9, bgcolor="white", splines=spline];
