digraph G { graph [rankdir=LR, fontname="Helvetica", fontsize=20, labelloc=t, label="Figura 3 — Copiloto EcoCity (relatórios e perguntas da IA)", pad=0.4, nodesep=0.5, ranksep=0.9, bgcolor="white", splines=spline];
node [shape=plaintext, fontname="Helvetica", fontsize=10]; edge [color="#64748B", dir=none, penwidth=1.2, fontname="Helvetica-Bold", fontsize=13, fontcolor="#B45309", labeldistance=1.6, labelangle=25];
