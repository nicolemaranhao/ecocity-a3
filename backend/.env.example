# Copie para .env e ajuste. NUNCA versione o .env real (está no .gitignore).
PORT=3000
DB_HOST=127.0.0.1          # na OCI: IP privado do MySQL HeatWave
DB_PORT=3306
DB_USER=ecocity_api
DB_PASS="Api#EcoCity2026!"
DB_NAME=ecocity
DB_SSL=false               # true em produção (OCI)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES=8h
CORS_ORIGIN=*

# Copiloto EcoCity: usuário SOMENTE LEITURA usado para rodar o SQL gerado pela IA
DB_IA_USER=ecocity_ia
DB_IA_PASS="Ia#EcoCity2026!"
# (opcional) IA generativa da Anthropic. Sem chave, o Copiloto usa o modelo local (regras + modelos de texto).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Chave que criptografa (AES) o segredo do aplicativo autenticador no banco. Troque em produção (OCI Vault).
MFA_KEY=chave-demo-ecocity

# Robô de coleta automática (todo mês) e IA de alertas: usuário de carga (ecocity_etl)
DB_ETL_USER=ecocity_etl
DB_ETL_PASS="Etl#EcoCity2026!"
COLETA_AUTOMATICA=false    # true = liga o robô que confere os sites dos órgãos públicos sozinho
COLETA_INTERVALO_HORAS=24  # de quantas em quantas horas ele confere (só baixa de novo o que mudou)
COLETA_MODO=mensal         # mensal = o painel avança todo mês que a ANEEL e a SPTrans publicam (o resto usa o último dado oficial); oficial = só avança quando água e emissões do ano saírem
COLETA_ANEEL_DIAS=7        # o arquivo da ANEEL tem ~110 MB: baixa no máximo a cada 7 dias
ANEEL_CKAN=https://dadosabertos.aneel.gov.br

# Endereços das fontes (só mude se o órgão trocar o endereço)
SPTRANS_PDF_URL=https://www.sptrans.com.br/media/18358/atualizacao-site-02102026.pdf
# EPE_XLSX_URL=   SEEG_GRAPHQL=   PAINEL_SANEAMENTO=   SINISA_PAGINAS=   (vazios = endereços padrão)
